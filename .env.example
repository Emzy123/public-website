#####################################################################
# SINet Environment Template
#
# NODE_ENV behavior:
# - development: security checks remain active, but API errors include
#   helpful details when configuration is missing.
# - production: strict mode; missing required configuration causes hard
#   failures with generic error payloads.
#####################################################################

# Runtime mode
NODE_ENV=development

# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (required for contact + academy APIs)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_DB=sinet
# Optional fallback when SRV/DNS fails on restricted networks
MONGODB_URI_DIRECT=mongodb://<username>:<password>@<host>:27017/<db>?tls=true&directConnection=true&authSource=admin

# Security: reCAPTCHA (required for waitlist API)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<recaptcha_site_key>
RECAPTCHA_SECRET_KEY=<recaptcha_secret_key>

# Security: CSRF
CSRF_SECRET=<csrf_secret_random_32+_chars>

# Rate limiting (recommended in production)
UPSTASH_REDIS_REST_URL=https://<your-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash_rest_token>

# Email service selection (waitlist currently uses Resend adapter)
EMAIL_SERVICE=resend
RESEND_API_KEY=<resend_api_key>
RESEND_AUDIENCE_ID=<resend_audience_id>
RESEND_FROM_EMAIL="SINet <noreply@sinet.africa>"
RESEND_CONTACT_TO_EMAIL=contact@sinet.africa

# Optional analytics/social
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=

# Alternative provider placeholders (reserved for future adapters)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
