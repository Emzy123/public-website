# Email Service (Mailchimp/ConvertKit/SendGrid)
EMAIL_SERVICE_API=https://api.mailchimp.com/3.0
EMAIL_SERVICE_KEY=your_api_key_here
EMAIL_LIST_ID=your_list_id_here

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

# CSRF
CSRF_SECRET=your_random_secret_here

# Site URL
NEXT_PUBLIC_SITE_URL=https://sinet.africa
