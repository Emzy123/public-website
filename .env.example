#####################################################################
# SINet Environment Template (.env.example)
#
# NODE_ENV behavior:
# - development: security checks remain active, but API errors include
#   helpful details when configuration is missing. Rate limiting fails open.
# - production: strict mode; missing required configuration causes hard
#   failures with generic error payloads. Rate limiting fails closed.
#####################################################################

# -----------------------------------------------------------------------------
# Runtime & Core Configuration
# -----------------------------------------------------------------------------
# Runtime mode ('development' | 'production' | 'test')
NODE_ENV=development

# Canonical public site URL (used for origin checks, metadataBase, sitemap, canonical links, emails)
# Local: http://localhost:3000 | Production: https://www.sinet.africa
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin Dashboard & Authentication (/admin)
# -----------------------------------------------------------------------------
# Admin account email required for login at /admin/login
ADMIN_EMAIL=admin@sinet.africa

# Scrypt hash for admin password in salt:hash format (generate via: npx tsx scripts/hash-admin-password.ts "password")
ADMIN_PASSWORD_HASH=<salt:hash>

# Optional plaintext password fallback for local development only (never set in production)
# ADMIN_PASSWORD=

# Random 32+ character string used to sign and verify admin session JWT cookies (sinet_admin_session)
ADMIN_SESSION_SECRET=<random_32+_chars>

# Base32 secret for Admin MFA / TOTP (required in production; optional in local development)
ADMIN_TOTP_SECRET=<base32_totp_secret>

# Media signing secret for uploaded images / GridFS preview links (falls back to ADMIN_SESSION_SECRET if unset)
MEDIA_SIGNING_SECRET=<random_32+_chars>

# Secret token required to access detailed dependency diagnostics on /api/health (passed via header or ?token=)
HEALTH_CHECK_TOKEN=<random_token>

# Notification recipient email for contact and academy form alert emails
ADMIN_NOTIFY_EMAIL=admin@sinet.africa

# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------
# MongoDB connection URI (Local: mongodb://localhost:27017 | Production: MongoDB Atlas connection string)
# Used for CMS content, team, reps, empires, contact submissions, academy submissions
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority

# MongoDB database name (default: sinet)
MONGODB_DB=sinet

# Optional direct connection URI fallback when SRV/DNS lookups fail on restricted networks
MONGODB_URI_DIRECT=mongodb://<username>:<password>@<host>:27017/<db>?tls=true&directConnection=true&authSource=admin

# -----------------------------------------------------------------------------
# Bot Protection & CSRF
# -----------------------------------------------------------------------------
# Google reCAPTCHA v3 public site key (used on frontend forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<recaptcha_site_key>

# Google reCAPTCHA v3 private secret key (used by server route handlers to verify submission tokens)
RECAPTCHA_SECRET_KEY=<recaptcha_secret_key>

# Secret key for CSRF token signing (@edge-csrf / CMS preview fallback)
CSRF_SECRET=<csrf_secret_random_32+_chars>

# -----------------------------------------------------------------------------
# Rate Limiting (Upstash Redis)
# -----------------------------------------------------------------------------
# Upstash Redis REST URL (required in production; public forms fail closed if unset in production)
UPSTASH_REDIS_REST_URL=https://<your-endpoint>.upstash.io

# Upstash Redis REST bearer token
UPSTASH_REDIS_REST_TOKEN=<upstash_rest_token>

# -----------------------------------------------------------------------------
# Email Service (Resend)
# -----------------------------------------------------------------------------
# Active email provider adapter ('resend' is currently implemented)
EMAIL_SERVICE=resend

# Resend API key for transactional emails
RESEND_API_KEY=<resend_api_key>

# Resend Audience ID for waitlist subscribers
RESEND_AUDIENCE_ID=<resend_audience_id>

# Sender display name and email address for transactional emails
RESEND_FROM_EMAIL="SINet <noreply@sinet.africa>"

# Destination email address for public contact form inquiries
RESEND_CONTACT_TO_EMAIL=sinetworkinggobal@gmail.com

# -----------------------------------------------------------------------------
# Analytics & Social Media (Optional)
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta / Facebook Pixel ID
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Social profile links
NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/sinetafrica
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=https://linkedin.com/company/sinetafrica
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://facebook.com/sinetafrica

# -----------------------------------------------------------------------------
# Alternative Email Provider Placeholders (Reserved for future adapters)
# -----------------------------------------------------------------------------
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
SENDGRID_API_KEY=
SENDGRID_LIST_ID=
